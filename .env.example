# Optional: cloud accounts (sign-in + synced history) with Supabase. See docs/DEPLOY.md.
# Leave both empty for local-only mode (no sign-in; data stays in the browser).
# These are public values; never put the service_role key here.
HAFEEZ_SUPABASE_URL=
HAFEEZ_SUPABASE_ANON_KEY=

# Local static server (npm start / npm run dev):
PORT=5173
HOST=127.0.0.1
